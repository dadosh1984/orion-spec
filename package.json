{
  "name": "orion-spec",
  "version": "0.42.0",
  "packageManager": "pnpm@11.18.0",
  "description": "Self-contained AI-agent toolkit: deterministic think → draft → forge → shield workflow with zero dependencies at runtime.",
  "type": "module",
  "bin": {
    "orion": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadosh1984/orion-spec.git"
  },
  "keywords": [
    "ai",
    "agent",
    "tdd",
    "yagni",
    "cache",
    "cli",
    "zero-dependency"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "core:coverage": "node scripts/check-core-coverage.mjs",
    "watch": "tsc -w -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "tdd": "node dist/cli/index.js tdd",
    "metrics": "node dist/cli/index.js metrics",
    "ci": "pnpm run lint && pnpm run format:check && pnpm exec tsc --noEmit && pnpm run build && pnpm run test:coverage && pnpm run core:coverage"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "orion-spec": "link:"
  }
}
